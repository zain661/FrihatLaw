# Copy to scripts/.env and fill in real values. Never commit scripts/.env —
# it's covered by the repo's ".env" gitignore rule, same as the client one.
#
# These are server-side-only secrets for scripts/send-newsletter.mjs.
# Do NOT prefix any of these with VITE_ — that would bundle them into the
# public site's JS, exposing them to every visitor.

# Full Postgres connection string for the Railway database (copy from the
# Postgres service's Variables tab in the Railway dashboard — DATABASE_URL).
# This connects directly to Postgres, bypassing PostgREST/RLS entirely, same
# trust level as the old Supabase service-role key.
DATABASE_URL=

# Resend dashboard -> API Keys.
RESEND_API_KEY=

# A sender address on a domain verified in Resend -> Domains. Sending from
# an unverified domain will fail or land in spam. Format: "Name <email@domain>".
RESEND_FROM_EMAIL=

# Optional — defaults to the production Railway URL if omitted.
SITE_URL=

# Public URL of the Uploads service (no trailing slash). Only needed to run
# scripts/migrate-images.mjs once during the Supabase -> Railway migration.
UPLOAD_URL=
